{
  "name": "ACR Sensitive Action Gate",
  "nodes": [
    {
      "id": "webhook",
      "name": "Agent Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        260
      ],
      "webhookId": "acr-sensitive-action",
      "parameters": {
        "httpMethod": "POST",
        "path": "acr-sensitive-action",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      }
    },
    {
      "id": "evaluate",
      "name": "ACR Evaluate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "http://acr-gateway:8000/acr/evaluate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { agent_id: \"n8n-support-demo\", action: { tool_name: \"create_ticket\", parameters: { customer_id: \"C-N8N-SYNTHETIC\", subject: $json.body.subject, priority: \"normal\" }, description: \"Create synthetic support ticket from n8n webhook\" }, context: { session_id: \"n8n-\" + $execution.id } } }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "respond",
      "name": "Return ACR Decision",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        800,
        260
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Agent Webhook": {
      "main": [
        [
          {
            "node": "ACR Evaluate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ACR Evaluate": {
      "main": [
        [
          {
            "node": "Return ACR Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}

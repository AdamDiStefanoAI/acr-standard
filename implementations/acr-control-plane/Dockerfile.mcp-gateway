# Stage 1: build
FROM python:3.12-slim AS builder
# Version for hatch-vcs (no .git in build context). Set via --build-arg
# from CI; defaults to 0.0.0+unknown for local builds.
ARG SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0+unknown
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
RUN pip install --no-cache-dir build wheel \
    && pip wheel --no-cache-dir --wheel-dir /wheels .

# Stage 2: runtime
FROM python:3.12-slim AS runtime
WORKDIR /app
LABEL org.opencontainers.image.licenses="Apache-2.0"
COPY LICENSE /app/LICENSE
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels acr-control-plane \
    && rm -rf /wheels
COPY src/ ./src/

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
# The pinned tool catalog is in-memory state held per process
# (src/acr/mcp_gateway). More than one worker splits that state:
# a definition change observed by one process is invisible to
# the others, and tool-pinning enforcement becomes a coin flip
# (red-team finding F-4, category 11, 2026-11-23). The v1.5.0
# deployment contract is one gateway instance fronting one
# upstream server, as a single process.
ENV WEB_CONCURRENCY=1

EXPOSE 8080

RUN useradd -r -u 1000 acr
USER acr

CMD ["uvicorn", "acr.mcp_gateway.service:app", "--host", "0.0.0.0", "--port", "8080"]
